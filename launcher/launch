#!/bin/zsh
# Claude (Proxy) launcher — 固定代理 + 可选独立账号档案
#
# 本文件不含任何机器特定的硬编码值。配置来源（优先级从高到低）:
#   代理  1. 第一个 http(s):// 参数         ./launch http://127.0.0.1:7897
#         2. CLAUDE_PROXY 环境变量
#         3. ~/.claude-proxy/proxy.env 的 PROXY=
#   账号  1. 第一个普通参数                 ./launch account2
#         2. CLAUDE_ACCOUNT 环境变量
#         3. ~/.claude-accounts/current（由 accounts.sh use 写入）
#         未配置时沿用 Claude 默认数据目录，兼容原有行为
#   Claude 路径: CLAUDE_BIN 或 proxy.env 的 CLAUDE_BIN=，未配置则自动探测
#
# 未配置代理时直接报错退出：不猜测、不扫描、不跟随系统代理。
# 账号由 --user-data-dir + CLAUDE_USER_DATA_DIR 双重指定，切换前必须完全退出 Claude。

CONFIG_FILE="$HOME/.claude-proxy/proxy.env"
ACCOUNTS_DIR="$HOME/.claude-accounts"
CURRENT_FILE="$ACCOUNTS_DIR/current"
LOG="$HOME/.claude-proxy/launch.log"

# ---- 读取配置（只解析 KEY=VALUE 行，不执行文件内容）----
CFG_PROXY=""; CFG_BIN=""
if [[ -r "$CONFIG_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      PROXY=*)      CFG_PROXY="${line#PROXY=}" ;;
      CLAUDE_BIN=*) CFG_BIN="${line#CLAUDE_BIN=}" ;;
    esac
  done < "$CONFIG_FILE"
  CFG_PROXY="${CFG_PROXY//\"/}"; CFG_BIN="${CFG_BIN//\"/}"
fi

# ---- 解析参数：第一个 URL 当代理，第一个普通词当账号，其余原样透传 ----
ARG_PROXY=""; ARG_ACCOUNT=""; EXTRA=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == *://* && -z "$ARG_PROXY" ]]; then
    ARG_PROXY="$1"
  elif [[ "$1" != -* && -z "$ARG_ACCOUNT" ]]; then
    ARG_ACCOUNT="$1"
  else
    EXTRA+=("$1")
  fi
  shift
done

PROXY="${ARG_PROXY:-${CLAUDE_PROXY:-$CFG_PROXY}}"
if [[ -z "$PROXY" ]]; then
  print -u2 -- "错误: 未配置代理地址。"
  print -u2 -- "运行 ./launcher/setup.sh 生成配置，或创建 $CONFIG_FILE 写入:"
  print -u2 -- '  PROXY="http://127.0.0.1:7897"'
  exit 1
fi

# ---- 选择账号档案 ----
ACCOUNT="${ARG_ACCOUNT:-${CLAUDE_ACCOUNT:-}}"
if [[ -z "$ACCOUNT" && -r "$CURRENT_FILE" ]]; then
  IFS= read -r ACCOUNT < "$CURRENT_FILE"
  ACCOUNT="${ACCOUNT//[[:space:]]/}"
fi
ACCOUNT_ARGS=()
if [[ -n "$ACCOUNT" ]]; then
  if [[ ! "$ACCOUNT" =~ ^[A-Za-z0-9._-]+$ ]]; then
    print -u2 -- "错误: 账号名只能包含字母、数字、点、下划线、连字符: $ACCOUNT"
    exit 1
  fi
  PROFILE="$ACCOUNTS_DIR/$ACCOUNT"
  mkdir -p "$PROFILE" || { print -u2 -- "错误: 无法创建档案目录 $PROFILE"; exit 1; }
  chmod 700 "$PROFILE" 2>/dev/null
  export CLAUDE_USER_DATA_DIR="$PROFILE"
  ACCOUNT_ARGS=(--user-data-dir="$PROFILE")
fi

# ---- 定位 Claude Desktop ----
find_claude() {
  local c
  for c in "/Applications/Claude.app/Contents/MacOS/Claude" \
           "$HOME/Applications/Claude.app/Contents/MacOS/Claude"; do
    [[ -x "$c" ]] && { print -r -- "$c"; return 0; }
  done
  if command -v mdfind >/dev/null 2>&1; then
    c="$(mdfind "kMDItemCFBundleIdentifier == 'com.anthropic.claudefordesktop'" 2>/dev/null | head -1)"
    [[ -n "$c" && -x "$c/Contents/MacOS/Claude" ]] && { print -r -- "$c/Contents/MacOS/Claude"; return 0; }
  fi
  return 1
}
CLAUDE_BIN="${CLAUDE_BIN:-$CFG_BIN}"
[[ -n "$CLAUDE_BIN" ]] || CLAUDE_BIN="$(find_claude)"
if [[ -z "$CLAUDE_BIN" || ! -x "$CLAUDE_BIN" ]]; then
  print -u2 -- "错误: 找不到 Claude Desktop 可执行文件。可设置 CLAUDE_BIN 或在 $CONFIG_FILE 中指定。"
  exit 1
fi

# ---- 前置检查（只提示，不阻断）----
mkdir -p "$(dirname "$LOG")" 2>/dev/null
echo "[$(date '+%Y-%m-%d %H:%M:%S')] launch proxy=$PROXY account=${ACCOUNT:-<default>} via $CLAUDE_BIN" >> "$LOG" 2>/dev/null

host="${PROXY#*://}"; host="${host%%/*}"; host="${host%%:*}"
port="${PROXY##*:}";  port="${port%%/*}"
case "$port" in
  ''|*[!0-9]*) : ;;
  *) if command -v nc >/dev/null 2>&1 && ! nc -z -G 2 "$host" "$port" 2>/dev/null; then
       print -u2 -- "警告: 代理 $PROXY 当前不可达；Claude 不会回退直连，启动后将无法联网。"
     fi ;;
esac

if pgrep -f "$CLAUDE_BIN" >/dev/null 2>&1; then
  print -u2 -- "警告: Claude 已在运行，单实例机制可能忽略本次启动参数（请先 ⌘Q 完全退出，尤其是切换账号时）。"
fi

# ---- 环境变量（Code / MCP 等子进程）----
export HTTP_PROXY="$PROXY" HTTPS_PROXY="$PROXY" ALL_PROXY="$PROXY"
export http_proxy="$PROXY" https_proxy="$PROXY" all_proxy="$PROXY"
export NO_PROXY="localhost,127.0.0.1,::1,.local"
export no_proxy="$NO_PROXY"

# ---- 启动 ----
exec "$CLAUDE_BIN" \
  --proxy-server="$PROXY" \
  --proxy-bypass-list="localhost;127.0.0.1;::1" \
  "${ACCOUNT_ARGS[@]}" \
  "${EXTRA[@]}"
